# ============================================================
# GoCast — пример конфигурации
# Скопируй в .env и подставь свои значения.
# Все значения не-секретные. Секреты остаются в K8s Secret-манифестах.
# После изменения .env выполни: make render
# ============================================================

# ------------------------------------------------------------
# Domain / URLs
# ------------------------------------------------------------
DOMAIN=your-domain.com
API_DOMAIN=api.your-domain.com
STORAGE_DOMAIN=storage.your-domain.com
CONSOLE_DOMAIN=console.your-domain.com
# Email бутстрап-админа (identity-service: role=admin)
ADMIN_EMAIL=admin@your-domain.com
# Адрес gRPC identity внутри кластера
AUTH_SERVICE_ADDRESS=identity-service:50051

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=database1

# ------------------------------------------------------------
# MinIO
# ------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=go-app-bucket
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_SERVER_URL=http://minio.go-app.svc.cluster.local:9000
MINIO_BROWSER_REDIRECT_URL=https://console.your-domain.com
MINIO_API_CORS_ALLOW_ORIGIN=https://your-domain.com

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_ADDR=casbin-redis-master:6379

# ------------------------------------------------------------
# Frontend (Vite build-time аргументы web-frontend/Dockerfile)
# Используются при: make build-web
# ------------------------------------------------------------
VITE_API_URL=https://api.your-domain.com
VITE_WS_URL=wss://api.your-domain.com/stream/ws/updates
VITE_HLS_URL=https://api.your-domain.com
VITE_STORAGE_URL=https://storage.your-domain.com/go-app-bucket/thumbnails