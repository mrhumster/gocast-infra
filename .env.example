# ============================================================
# GoCast — пример конфигурации
# Скопируй в .env и подставь свои значения.
# Все значения не-секретные. Секреты остаются в K8s Secret-манифестах.
# После изменения .env выполни: make render
# ============================================================

# ------------------------------------------------------------
# Domain / URLs
# ------------------------------------------------------------
DOMAIN=your-domain.com
API_DOMAIN=api.your-domain.com
STORAGE_DOMAIN=storage.your-domain.com
CONSOLE_DOMAIN=console.your-domain.com
# Grafana (отдельный subdomain; дефолт grafana.<DOMAIN>)
GRAFANA_DOMAIN=grafana.your-domain.com
# Events-service (лента активности; дефолт events.<DOMAIN>)
EVENTS_DOMAIN=events.your-domain.com
# Email бутстрап-админа (identity-service: role=admin)
ADMIN_EMAIL=admin@your-domain.com
# Адрес gRPC identity внутри кластера
AUTH_SERVICE_ADDRESS=identity-service:50051

# CORS/WS allowlist для бэкенда (identity + stream). Кома-разделённый список.
# Убедись, что сюда входят фронт-host, api-host и dev-origin.
CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-domain.com,https://api.your-domain.com

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=database1

# ------------------------------------------------------------
# MinIO
# ------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=go-app-bucket
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_SERVER_URL=http://minio.go-app.svc.cluster.local:9000
MINIO_BROWSER_REDIRECT_URL=https://console.your-domain.com
MINIO_API_CORS_ALLOW_ORIGIN=https://your-domain.com

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_ADDR=casbin-redis-master:6379

# ------------------------------------------------------------
# Metrics (Prometheus exporters)
# Адрес экспорта метрик worker-сервисов (thumbnail/transcoder/mailer).
# identity/stream слушают те же эндпоинт на SERVER_ADDR (:8080/metrics).
# ------------------------------------------------------------
METRICS_ADDR=:9090

# ------------------------------------------------------------
# Transcoder (video encoder mode)
# TRANSCODER_ENCODER controls hardware/software encoding at startup.
#   auto  – prefer hardware if /dev/dri/renderD128 + h264_vaapi are present, else CPU
#   cpu   – always libx264 (software fallback)
#   vaapi – require AMD/Intel VAAPI encoder (fail loudly if missing)
# ------------------------------------------------------------
TRANSCODER_ENCODER=auto

# ------------------------------------------------------------
# Mail (mailer-service)
# SMTP_ADDR пуст -> mailer работает в лог-режиме (письма не отправляются,
# полное содержимое печатается в лог воркера). SMTP_PASS — отдельный
# Secret (deploy/k8s/mailer/smtp-secret.yaml), в .env не хранится.
# FRONTEND_URL — база ссылок подтверждения (домен фронтенда).
# ------------------------------------------------------------
SMTP_ADDR=
SMTP_USER=
SMTP_FROM=no-reply@your-domain.com
FRONTEND_URL=https://your-domain.com

# ------------------------------------------------------------
# Frontend (Vite build-time аргументы web-frontend/Dockerfile)
# Используются при: make build-web
# ------------------------------------------------------------
VITE_API_URL=https://api.your-domain.com
VITE_WS_URL=wss://api.your-domain.com/stream/ws/updates
VITE_HLS_URL=https://api.your-domain.com
VITE_STORAGE_URL=https://storage.your-domain.com/go-app-bucket/thumbnails