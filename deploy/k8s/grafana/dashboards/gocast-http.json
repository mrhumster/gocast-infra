{
  "uid": "gocast-http-latency",
  "title": "GoCast — HTTP & Latency",
  "tags": ["gocast"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      { "type": "query", "name": "namespace", "datasource": { "type": "prometheus", "uid": "prometheus" }, "definition": "label_values(namespace)", "query": "label_values(namespace)", "label": "namespace", "current": { "text": "go-app", "value": "go-app" }, "multi": false },
      { "type": "query", "name": "job", "datasource": { "type": "prometheus", "uid": "prometheus" }, "definition": "label_values(up{namespace=\"$namespace\"}, job)", "query": "label_values(up{namespace=\"$namespace\"}, job)", "label": "job", "current": { "text": "go-app-pods", "value": "go-app-pods" }, "multi": false }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(http_requests_total{namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error ratio (5xx)",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", job=\"$job\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\", job=\"$job\"}[5m])), 1)",
          "legendFormat": "5xx ratio",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests total (rate)",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods up",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.9 }] } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(up{namespace=\"$namespace\", job=\"$job\"})",
          "legendFormat": "up targets",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by status code",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{namespace=\"$namespace\", job=\"$job\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p95 by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", job=\"$job\"}[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Go goroutines by instance",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "expr": "go_goroutines{namespace=\"$namespace\", job=\"$job\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory resident set (RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{namespace=\"$namespace\", job=\"$job\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    }
  ]
}